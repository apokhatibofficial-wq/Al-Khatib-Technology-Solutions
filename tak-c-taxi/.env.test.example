# Copy to .env.test and point DATABASE_URL at a dedicated, disposable test
# database (never the dev DB — the test suite's resetDb() TRUNCATEs every
# application table between test files). Everything else needed (JWT
# secrets, REDIS_URL, ...) is inherited from your real .env — dotenv only
# fills in vars that aren't already set, and .env.test only needs to
# override DATABASE_URL/NODE_ENV.
#
# One-time setup for a fresh test database:
#   createdb tak_c_taxi_test
#   psql -d tak_c_taxi_test -c "CREATE EXTENSION postgis;"
#   # PostGIS's standard SRID definitions (spatial_ref_sys) are a separate
#   # seed script, not part of CREATE EXTENSION itself — without this,
#   # every ST_*(geography) call fails with "Cannot find SRID (4326)":
#   psql -d tak_c_taxi_test -f "$(pg_config --sharedir)/contrib/postgis-3.4/spatial_ref_sys.sql"
#   npm run db:deploy   # with DATABASE_URL pointed at tak_c_taxi_test
NODE_ENV=test
DATABASE_URL="postgresql://user:password@host:5432/tak_c_taxi_test"
