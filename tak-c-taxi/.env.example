# Names only — no real value is committed to the repo (per the architecture
# doc §13). Copy this file to .env and fill in real values locally / in your
# deployment platform's secret store.

# -----------------------------------------------------------------------------
# Phases 1-3 (built so far) — actually read and validated by src/config/env.ts.
# -----------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host:5432/tak_c_taxi"
# Not in the architecture doc's §13 list, but the Fastify server needs it.
# Optional — defaults to 3000 if unset.
PORT=3000

# Phase 2 (auth) — session tokens. Required in every environment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Phase 2 (auth) — OTP (primary) and Google OAuth (secondary) login paths.
# Optional in development (routes degrade gracefully); OTP_PROVIDER_KEY is
# required in production.
OTP_PROVIDER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Phase 3 (geo/pricing) — self-hosted routing (OSRM) + geocoding (Nominatim),
# per §2's explicit rejection of Google Maps for this deployment
# (export/sanctions risk). Optional in development (/geo/*, /rides/quote
# return 503 until set); both required in production.
ROUTING_ENGINE_URL=
GEOCODER_URL=

# -----------------------------------------------------------------------------
# Reserved by the architecture doc (§13) for later phases. Nothing in the
# code reads these yet.
# -----------------------------------------------------------------------------
# Phase 5 (real-time) — Redis for live locations, locks, queues.
REDIS_URL=

# Phase 5+ (map display) — MapLibre tile server. Distinct from
# ROUTING_ENGINE_URL/GEOCODER_URL above: this serves map *tiles* to the
# frontends, not routes/geocodes to this backend.
MAP_TILES_URL=

# Phase 8 (notifications) — Web Push (VAPID) and FCM.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_SERVER_KEY=

# Driver/vehicle photos and documents — S3-compatible object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability.
SENTRY_DSN=

# No city is ever hardcoded (§3/§9) — this only seeds which City row a fresh
# deployment treats as its default (e.g. for admin-panel defaults), it does
# not hardcode pricing or service-area logic.
DEFAULT_CITY_ID=
