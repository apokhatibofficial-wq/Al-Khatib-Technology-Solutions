# Names only — no real value is committed to the repo (per the architecture
# doc §13). Copy this file to .env and fill in real values locally / in your
# deployment platform's secret store.

# -----------------------------------------------------------------------------
# Phases 1-8 (built so far) — actually read and validated by src/config/env.ts.
# -----------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host:5432/tak_c_taxi"
# Not in the architecture doc's §13 list, but the Fastify server needs it.
# Optional — defaults to 3000 if unset.
PORT=3000

# Phase 2 (auth) — session tokens. Required in every environment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Phase 2 (auth) — OTP (primary) and Google OAuth (secondary) login paths.
# Optional in development (routes degrade gracefully); OTP_PROVIDER_KEY is
# required in production.
OTP_PROVIDER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Phase 3 (geo/pricing) — self-hosted routing (OSRM) + geocoding (Nominatim),
# per §2's explicit rejection of Google Maps for this deployment
# (export/sanctions risk). Optional in development (/geo/*, /rides/quote
# return 503 until set); both required in production.
ROUTING_ENGINE_URL=
GEOCODER_URL=

# Phase 5 (real-time, §1/§6) — live driver locations (Redis GEOADD/
# GEOSEARCH) and the ride/driver/city WebSocket pub-sub channels. Required
# in every environment, not just production — driver matching itself now
# depends on this (see prisma/migrations/*_driver_live_location_to_redis).
REDIS_URL="redis://localhost:6379"

# Phase 8 (notifications, §2/§11) — standard Web Push, VAPID-authenticated.
# Generate a real pair with `npx web-push generate-vapid-keys`. Optional in
# development (push silently no-ops via a clear NOT_CONFIGURED delivery
# status); all three required in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI the push services can reach you at if they need to — a
# 'mailto:' address or an 'https:' URL. Required by the Web Push protocol
# itself; not in the doc's §13 list (that list has VAPID_PUBLIC_KEY/
# VAPID_PRIVATE_KEY but not this) but web-push won't sign a request without it.
VAPID_SUBJECT="mailto:ops@example.com"
# §13 names this, but this project has no native app to use it from — see
# src/config/env.ts's comment. Left here, unused, in case that changes.
FCM_SERVER_KEY=

# -----------------------------------------------------------------------------
# Reserved by the architecture doc (§13) for later phases. Nothing in the
# code reads these yet.
# -----------------------------------------------------------------------------
# Phase 5+ (map display) — MapLibre tile server. Distinct from
# ROUTING_ENGINE_URL/GEOCODER_URL above: this serves map *tiles* to the
# frontends, not routes/geocodes to this backend.
MAP_TILES_URL=

# Driver/vehicle photos and documents — S3-compatible object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability.
SENTRY_DSN=

# No city is ever hardcoded (§3/§9) — this only seeds which City row a fresh
# deployment treats as its default (e.g. for admin-panel defaults), it does
# not hardcode pricing or service-area logic.
DEFAULT_CITY_ID=
