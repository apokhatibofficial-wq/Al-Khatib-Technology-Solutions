generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  INDIVIDUAL
  BUSINESS
}

enum PaymentStatus {
  PAID
  UNPAID
  LATE
}

enum PublicPageType {
  INDIVIDUAL
  BUSINESS
}

enum VisitSource {
  LINK
  QR
}

enum ContactButtonKind {
  CALL
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  CUSTOM_LINK
}

enum ProductContactMode {
  NONE
  CALL
  LINK
}

enum AttachmentKind {
  NONE
  IMAGE
  FILE
}

// ---------------------------------------------------------------------------
// Identity, auth, RBAC
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  location     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  permissions          SubAdminPermission[]
  sessions             Session[]
  subscription         Subscription?
  publicPage           PublicPage?
  auditLogsAsActor     AuditLog[]              @relation("AuditActor")
  auditLogsAsTarget    AuditLog[]              @relation("AuditTarget")
  sentNotifications    Notification[]          @relation("NotificationSender")
  notificationReceipts NotificationRecipient[]

  @@index([role])
  @@index([active])
  @@index([createdById])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

/// Grants one permission key (see lib/rbac.ts PERMISSIONS catalog) to a sub-admin user.
/// Super admins bypass this table entirely (full access by role).
model SubAdminPermission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String

  @@unique([userId, key])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Subscriptions & billing (fully manual per admin decision — no payment gateway)
// ---------------------------------------------------------------------------

model Subscription {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          PaymentStatus @default(UNPAID)
  cycleStart      DateTime      @default(now())
  cycleDays       Int           @default(30)
  lastRenewedAt   DateTime?
  lastRenewedById String?
  notes           String?
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin-managed, extensible taxonomy (starts empty — no seed data)
// ---------------------------------------------------------------------------

model ActivityCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  businesses BusinessProfile[]
}

model Profession {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  individuals IndividualProfile[]
}

// ---------------------------------------------------------------------------
// Public page (shared publish + analytics substrate for individual & business)
// ---------------------------------------------------------------------------

model PublicPage {
  id                    String         @id @default(cuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  PublicPageType
  slug                  String         @unique
  layoutTemplate        String         @default("classic")
  brandColor            String         @default("#0d6ebe")
  showWatermark         Boolean        @default(true)
  published             Boolean        @default(false)
  hasUnpublishedChanges Boolean        @default(false)
  firstPublishedAt      DateTime?
  publishedAt           DateTime?
  /// Snapshot of everything needed to render the public page, written only on publish.
  publishedSnapshot     Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  individualProfile IndividualProfile?
  businessProfile   BusinessProfile?
  contactButtons    ContactButton[]
  visits            Visit[]

  @@index([type])
  @@index([published])
}

model IndividualProfile {
  id           String      @id @default(cuid())
  pageId       String      @unique
  page         PublicPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  displayName  String
  professionId String?
  profession   Profession? @relation(fields: [professionId], references: [id], onDelete: SetNull)
  bio          String      @default("")
  avatarUrl    String?
  coverUrl     String?
  updatedAt    DateTime    @updatedAt

  @@index([professionId])
}

model BusinessProfile {
  id                    String            @id @default(cuid())
  pageId                String            @unique
  page                  PublicPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  companyName           String
  activityCategoryId    String?
  activityCategory      ActivityCategory? @relation(fields: [activityCategoryId], references: [id], onDelete: SetNull)
  description           String            @default("")
  logoUrl               String?
  avatarUrl             String?
  coverUrl              String?
  splashEnabled         Boolean           @default(false)
  splashImageUrl        String?
  splashDurationSeconds Int               @default(3)
  updatedAt             DateTime          @updatedAt

  categories ProductCategory[]
  products   Product[]
  coupons    Coupon[]

  @@index([activityCategoryId])
}

/// One row per contact-button kind per page; presence + `enabled` controls public rendering.
model ContactButton {
  id        String            @id @default(cuid())
  pageId    String
  page      PublicPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  kind      ContactButtonKind
  enabled   Boolean           @default(false)
  value     String?
  label     String?
  sortOrder Int               @default(0)

  @@unique([pageId, kind])
  @@index([pageId])
}

// ---------------------------------------------------------------------------
// Business: products, categories, coupons
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String          @id @default(cuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int             @default(0)
  /// Dynamic field schema for this category: [{ key, label, type }]
  fieldSchema Json            @default("[]")
  createdAt   DateTime        @default(now())

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id                String             @id @default(cuid())
  businessId        String
  business          BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  description       String             @default("")
  imageUrl          String?
  price             Decimal            @db.Decimal(12, 2)
  discountCode      String?
  quantityRemaining Int?
  deliveryEnabled   Boolean            @default(false)
  contactMode       ProductContactMode @default(NONE)
  contactValue      String?
  /// Values keyed by the owning category's fieldSchema keys.
  dynamicFields     Json               @default("{}")
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([businessId])
  @@index([categoryId])
}

model Coupon {
  id          String          @id @default(cuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  color       String          @default("#e08a1f")
  startDate   DateTime?
  endDate     DateTime?
  placement   String          @default("top")
  published   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model Visit {
  id        String      @id @default(cuid())
  pageId    String
  page      PublicPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source    VisitSource
  visitedAt DateTime    @default(now())

  @@index([pageId, source])
  @@index([pageId, visitedAt])
}

// ---------------------------------------------------------------------------
// Audit log (§4.4)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  summary      String
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Messaging / notifications (§4.7 — in-app only)
// ---------------------------------------------------------------------------

model Notification {
  id             String         @id @default(cuid())
  senderId       String
  sender         User           @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  title          String
  body           String
  attachmentKind AttachmentKind @default(NONE)
  attachmentUrl  String?
  broadcast      Boolean        @default(false)
  createdAt      DateTime       @default(now())

  recipients NotificationRecipient[]

  @@index([senderId])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Global settings (singleton row, id = "global")
// ---------------------------------------------------------------------------

model SystemSetting {
  id                       String  @id @default("global")
  watermarkEnabledGlobally Boolean @default(true)
}
