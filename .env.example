# -----------------------------------------------------------------------------
# Database (Postgres). With Vercel, use Neon / Vercel Postgres / Supabase.
# DATABASE_URL: pooled connection (used by the app at runtime).
# DIRECT_URL: direct, non-pooled connection (used only for migrations).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/idlib?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/idlib?sslmode=require"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL of the deployment, no trailing slash. Used to build public
# page links and to encode the QR code target.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# One-time secret required (in addition to the DB being empty) to create the
# real Super Admin account at /setup. Generate a long random value and keep it
# secret; you only need it once. Example: `openssl rand -hex 32`
SETUP_TOKEN="change-me-before-deploying"

# -----------------------------------------------------------------------------
# Object storage (S3-compatible — e.g. Cloudflare R2) for avatars, covers,
# logos and product images. Leave unset in early local development; uploads
# will show a clear "storage not configured" error until these are set.
# -----------------------------------------------------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="idlib-uploads"
# Public base URL your bucket is served from (R2 public bucket URL or custom domain).
S3_PUBLIC_BASE_URL="https://uploads.example.com"
